<!DOCTYPE html>
<html>
<head>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
      padding: 20px;
    }

    .ticket {
      width: 700px;
      margin: auto;
      background: #fff;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid #ddd;
    }

    .header {
      background: #007bff;
      color: #fff;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .header h2 {
      margin: 0;
    }

    .body {
      padding: 20px;
    }

    .route {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .city {
      font-size: 22px;
      font-weight: bold;
    }

    .arrow {
      font-size: 20px;
      color: #888;
    }

    .details {
      display: flex;
      justify-content: space-between;
      margin-top: 20px;
    }

    .details div {
      width: 30%;
    }

    .label {
      font-size: 12px;
      color: #777;
    }

    .value {
      font-weight: bold;
      margin-top: 5px;
    }

    .footer {
      border-top: 1px dashed #ccc;
      padding: 15px 20px;
      text-align: center;
      font-size: 12px;
      color: #555;
    }

    .barcode {
      margin-top: 10px;
      font-size: 18px;
      letter-spacing: 3px;
    }
  </style>
</head>

<body>

<div class="ticket">

  <!-- Header -->
  <div class="header">
    <h2>✈ Flight Ticket</h2>
    <div><strong><%= flight.flightNumber %></strong></div>
  </div>

  <!-- Body -->
  <div class="body">

    <div class="route">
      <div class="city"><%= flight.departure %></div>
      <div class="arrow">➡</div>
      <div class="city"><%= flight.arrival %></div>
    </div>

    <div class="details">
      <div>
        <div class="label">Date</div>
        <div class="value"><%= flight.date %></div>
      </div>

      <div>
        <div class="label">Passenger</div>
        <div class="value">Debasish Das</div>
      </div>

      <div>
        <div class="label">Seat</div>
        <div class="value">12A</div>
      </div>
    </div>

  </div>

  <!-- Footer -->
  <div class="footer">
    Boarding Pass • Have a safe journey ✈
    <div class="barcode">||| ||| |||| |||</div>
  </div>

</div>

</body>
</html>